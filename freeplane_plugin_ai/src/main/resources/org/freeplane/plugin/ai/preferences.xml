<?xml version="1.0" encoding="UTF-8"?><preferences_structure xmlns="http://freeplane.sf.net/ui/preferences/1.0">
<tabbed_pane>
<tab name="plugins">
    <separator name="ai">
        <boolean name="ai_edits_state_icon_visible"/>
        <boolean name="ai_edits_persistence_enabled"/>
        <boolean name="ai_chat_shows_tool_calls"/>
        <radiobuttons name="ai_tool_availability">
            <choice value="SCRIPT_EXECUTION" text="OptionPanel.ToolAvailabilityLevel.SCRIPT_EXECUTION"/>
            <choice value="EDITING" text="OptionPanel.ToolAvailabilityLevel.EDITING"/>
            <choice value="READING" text="OptionPanel.ToolAvailabilityLevel.READING"/>
            <choice value="DISABLED" text="OptionPanel.ToolAvailabilityLevel.DISABLED"/>
        </radiobuttons>
        <radiobuttons name="ai_script_execution_policy">
            <choice value="SHOWN_USER_RUN" text="OptionPanel.AiScriptExecutionPolicy.SHOWN_USER_RUN"/>
            <choice value="SHOWN_AI_RUN" text="OptionPanel.AiScriptExecutionPolicy.SHOWN_AI_RUN"/>
            <choice value="HIDDEN_AI_RUN" text="OptionPanel.AiScriptExecutionPolicy.HIDDEN_AI_RUN"/>
        </radiobuttons>
        <radiobuttons name="ai_script_user_run_permission_mode">
            <choice value="UNRESTRICTED" text="OptionPanel.AiScriptUserRunPermissionMode.UNRESTRICTED"/>
            <choice value="AI_SPECIFIC_PERMISSIONS" text="OptionPanel.AiScriptUserRunPermissionMode.AI_SPECIFIC_PERMISSIONS"/>
        </radiobuttons>
        <boolean name="ai_script_without_file_restriction"/>
        <boolean name="ai_script_without_write_restriction"/>
        <boolean name="ai_script_without_network_restriction"/>
        <boolean name="ai_script_without_exec_restriction"/>
        <radiobuttons name="ai_attached_editor_chat_mode">
            <choice value="new_chat" text="OptionPanel.ai_attached_editor_chat_mode.new_chat"/>
            <choice value="reuse_current_chat" text="OptionPanel.ai_attached_editor_chat_mode.reuse_current_chat"/>
        </radiobuttons>
        <number name="ai_chat_font_scaling" min="25" max="400" />
        <number name="ai_chat_memory_maximum_token_count" min="2048" max="1048576" />
        <radiobuttons name="ai_chat_token_counter_mode">
            <choice value="hidden" text="OptionPanel.ai_chat_token_counter_mode.hidden"/>
            <choice value="context" text="OptionPanel.ai_chat_token_counter_mode.context"/>
            <choice value="total" text="OptionPanel.ai_chat_token_counter_mode.total"/>
            <choice value="model_response" text="OptionPanel.ai_chat_token_counter_mode.model_response"/>
        </radiobuttons>
        <boolean name="ai_unfolds_parents_on_create"/>
        <textbox name="ai_system_message" lines="5"/>
        <boolean name="ai_mcp_server_enabled"/>
        <number name="ai_mcp_server_port" min="1024" max="65535" />
        <secret name="ai_mcp_token"/>
        <string name="ai_openrouter_service_address"/>
        <secret name="ai_openrouter_key"/>
        <textbox name="ai_openrouter_model_allowlist" lines="5"/>
        <string name="ai_gemini_service_address"/>
        <secret name="ai_gemini_key"/>
        <textbox name="ai_gemini_model_list" lines="5"/>
        <string name="ai_ollama_service_address"/>
        <secret name="ai_ollama_api_key"/>
        <textbox name="ai_ollama_model_allowlist" lines="5"/>
    </separator>
</tab>
</tabbed_pane>
</preferences_structure>
