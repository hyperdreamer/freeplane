digraph boundary_separation {
  rankdir=TB;
  graph [fontname="Helvetica", labelloc="t", label="graph-boundary-separation execution graph"];
  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10];
  subgraph cluster_types {
    label="types";
    style=rounded; color="#999999";
    "t1" [label="1. Canonical layout keys\\n(standard)", fillcolor="#cfe2f3"];
    "t2" [label="2. Boundary separation exception and timings\\n(fast)", fillcolor="#cfe2f3"];
    "t3" [label="3. Boundary conflict\\n(standard)", fillcolor="#cfe2f3"];
    "t4" [label="4. Boundary separation diagnostics\\n(standard)", fillcolor="#cfe2f3"];
    "t5" [label="5. Boundary separation result\\n(fast)", fillcolor="#cfe2f3"];
    "t6" [label="6. Boundary invariant assertion helper\\n(standard)", fillcolor="#cfe2f3"];
  }
  subgraph cluster_correction {
    label="correction";
    style=rounded; color="#999999";
    "t7" [label="7. Boundary separation component skeleton, detection, and terminal coverage\\n(advanced)", fillcolor="#d9ead3"];
    "t8" [label="8. Cross-map rigid map translation\\n(advanced)", fillcolor="#d9ead3"];
    "t9" [label="9. Same-map support, cap sets, and both-sides/full candidates\\n(capable)", fillcolor="#d9ead3"];
    "t10" [label="10. Complementary splits, ties, and immovable sides\\n(capable)", fillcolor="#d9ead3"];
    "t11" [label="11. Bounded loop, ROUND_LIMIT reasons, and the I6 bijection\\n(advanced)", fillcolor="#d9ead3"];
    "t12" [label="12. Frozen real-case fixture and one-round regression\\n(advanced)", fillcolor="#d9ead3"];
  }
  subgraph cluster_integration {
    label="integration";
    style=rounded; color="#999999";
    "t13" [label="13. Migrate production call sites to BoundarySeparationCorrection\\n(advanced)", fillcolor="#fff2cc"];
    "t14" [label="14. Worker failure channel, displacement deltas, and restart reset\\n(standard)", fillcolor="#fff2cc"];
    "t15" [label="15. Performance diagnostic stage mapping and golden conflict expectations\\n(advanced)", fillcolor="#fff2cc"];
    "t16" [label="16. Performance gate measurement and evidence\\n(standard)", fillcolor="#fff2cc"];
  }
  subgraph cluster_pipeline {
    label="pipeline";
    style=rounded; color="#999999";
    "t17" [label="17. Reproduced-case pipeline fixture with red-before/green-after\\n(capable)", fillcolor="#f4cccc"];
    "t18" [label="18. Settle-sequence measurement and section-7 diagnostics gates\\n(advanced)", fillcolor="#f4cccc"];
    "t19" [label="19. Final acceptance evidence and full-suite verification\\n(standard)", fillcolor="#f4cccc"];
  }
  "t1" -> "t2";
  "t2" -> "t3";
  "t3" -> "t4";
  "t4" -> "t5";
  "t5" -> "t6";
  "t5" -> "t7";
  "t7" -> "t8";
  "t8" -> "t9";
  "t9" -> "t10";
  "t10" -> "t11";
  "t11" -> "t12";
  "t12" -> "t13";
  "t13" -> "t14";
  "t14" -> "t15";
  "t15" -> "t16";
  "t13" -> "t17";
  "t6" -> "t17";
  "t17" -> "t18";
  "t16" -> "t19";
  "t18" -> "t19";
}
