+    /**
+     * Detects repairs that repeat on consecutive frames and returns the repaired centres of only those nodes.
+     * A repeat means the correction is undoing work the relaxation undoes in turn, which is the measured limit
+     * cycle; seeding those nodes lets the relaxation continue from the repaired arrangement. Nodes repaired once
+     * are never seeded, so ordinary layouts keep their exact trajectory.
+     */
+    private Map<ProjectedNodeKey, LayoutPoint> oscillatingRepairs(final EdgeConflictResult edge) {
+        final Map<ProjectedNodeKey, LayoutPoint> seeded =
+            new java.util.LinkedHashMap<ProjectedNodeKey, LayoutPoint>();
+        final java.util.Set<String> seenThisFrame = new java.util.LinkedHashSet<String>();
+        for (final EdgeConflictDiagnostics.Repair repair : edge.diagnostics().repairsApplied()) {
+            final String signature = repairSignature(repair);
+            seenThisFrame.add(signature);
+            if (previousRepairSignatures.contains(signature)) {
+                seeded.putAll(repair.toCentres());
+            }
+        }
+        previousRepairSignatures.clear();
+        previousRepairSignatures.addAll(seenThisFrame);
+        return seeded;
+    }
+
+    private static String repairSignature(final EdgeConflictDiagnostics.Repair repair) {
+        final StringBuilder signature = new StringBuilder(repair.kind().name());
+        for (final ProjectedNodeKey key : repair.nodeKeys()) {
+            signature.append('|').append(key.source().persistent()
+                ? key.source().persistedReference().get().nodeId().toString() : "?");
+        }
+        return signature.toString();
+    }
+
